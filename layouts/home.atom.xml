{{- printf `<?xml version="1.0" encoding="utf-8"?>` | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <generator uri="https://gohugo.io/" version="{{ hugo.Version }}">Hugo</generator>
  <title>{{ site.Title }}</title>
  <subtitle>{{ site.Params.tagline }}</subtitle>
  <link href="{{ with .OutputFormats.Get "atom" }}{{ .Permalink }}{{ end }}" rel="self" type="application/atom+xml"/>
  <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
  <updated>{{ now.Format "2006-01-02T15:04:05-07:00" }}</updated>
  <author><name>{{ hugo.Data.profile.name }}</name><email>{{ hugo.Data.profile.email }}</email></author>
  <id>{{ .Permalink }}</id>
  {{- range where site.RegularPages "Section" "posts" }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05-07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</updated>
    <content type="html">{{ .Content | htmlEscape | safeHTML }}</content>
    {{- range .Params.tags }}
    <category term="{{ . | urlize }}" label="{{ . }}"/>
    {{- end }}
  </entry>
  {{- end }}
</feed>
